<resources>
    <properties>
        <property id="haBaseUrl" type="string">https://homeassistant.example.org</property>
        <property id="haToken" type="string"></property>
        <property id="haActionsConfig" type="string"></property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.haBaseUrl" title="@Strings.SettingBaseUrl">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.haToken" title="@Strings.SettingToken">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.haActionsConfig" title="@Strings.SettingActions">
            <settingConfig type="alphaNumeric" />
        </setting>
    </settings>
</resources>
